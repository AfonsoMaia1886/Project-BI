      {
        "type": "Script",
        "typeProperties": {
          "scripts": [
            {
              "text": {
                "value": "SELECT \r\n    'Row Count' AS ValidationType,\r\n    'DimDate' AS TableName,\r\n    COUNT(*) AS ResultValue,\r\n    'Should be > 0' AS ExpectedResult\r\nFROM dwh.DimDate\r\n\r\nUNION ALL\r\nSELECT 'Row Count', 'DimTime', COUNT(*), 'Should be > 0'\r\nFROM dwh.DimTime\r\n\r\nUNION ALL\r\nSELECT 'Row Count', 'DimProduct', COUNT(*), 'Should be > 0'\r\nFROM dwh.DimProduct\r\n\r\nUNION ALL\r\nSELECT 'Row Count', 'DimPharmacy', COUNT(*), 'Should be > 0'\r\nFROM dwh.DimPharmacy\r\n\r\nUNION ALL\r\nSELECT 'Row Count', 'DimLocation', COUNT(*), 'Should be > 0'\r\nFROM dwh.DimLocation\r\n\r\nUNION ALL\r\nSELECT 'Row Count', 'DimOperator', COUNT(*), 'Should be > 0'\r\nFROM dwh.DimOperator\r\n\r\nUNION ALL\r\nSELECT 'Row Count', 'DimPOS', COUNT(*), 'Should be > 0'\r\nFROM dwh.DimPOS\r\n\r\nUNION ALL\r\nSELECT 'Row Count', 'FactSales', COUNT(*), 'Should be > 0'\r\nFROM dwh.FactSales\r\n\r\nUNION ALL\r\nSELECT 'Row Count', 'PharmacySegmentation', COUNT(*), 'Should be > 0'\r\nFROM dwh.PharmacySegmentation;\r\n\r\n\r\nSELECT \r\n    'FactSales Null Check' AS ValidationType,\r\n    'Missing FK_Date' AS CheckName,\r\n    COUNT(*) AS ResultValue,\r\n    'Should be 0' AS ExpectedResult\r\nFROM dwh.FactSales\r\nWHERE FK_Date IS NULL\r\n\r\nUNION ALL\r\nSELECT 'FactSales Null Check', 'Missing FK_Time', COUNT(*), 'Should be 0'\r\nFROM dwh.FactSales\r\nWHERE FK_Time IS NULL\r\n\r\nUNION ALL\r\nSELECT 'FactSales Null Check', 'Missing FK_Product', COUNT(*), 'Should be 0'\r\nFROM dwh.FactSales\r\nWHERE FK_Product IS NULL\r\n\r\nUNION ALL\r\nSELECT 'FactSales Null Check', 'Missing FK_Pharmacy', COUNT(*), 'Should be 0'\r\nFROM dwh.FactSales\r\nWHERE FK_Pharmacy IS NULL\r\n\r\nUNION ALL\r\nSELECT 'FactSales Null Check', 'Missing FK_Location', COUNT(*), 'Should be 0'\r\nFROM dwh.FactSales\r\nWHERE FK_Location IS NULL\r\n\r\nUNION ALL\r\nSELECT 'FactSales Null Check', 'Missing FK_Operator', COUNT(*), 'Should be 0'\r\nFROM dwh.FactSales\r\nWHERE FK_Operator IS NULL\r\n\r\nUNION ALL\r\nSELECT 'FactSales Null Check', 'Missing FK_POS', COUNT(*), 'Should be 0'\r\nFROM dwh.FactSales\r\nWHERE FK_POS IS NULL\r\n\r\nUNION ALL\r\nSELECT 'FactSales Null Check', 'Missing Qty', COUNT(*), 'Should be 0'\r\nFROM dwh.FactSales\r\nWHERE Qty IS NULL\r\n\r\nUNION ALL\r\nSELECT 'FactSales Null Check', 'Missing Amount', COUNT(*), 'Should be 0'\r\nFROM dwh.FactSales\r\nWHERE Amount IS NULL;\r\n\r\n\r\n\r\nSELECT \r\n    'Notebook Output Check' AS ValidationType,\r\n    'Segmentation rows' AS CheckName,\r\n    COUNT(*) AS ResultValue,\r\n    'Should be > 0' AS ExpectedResult\r\nFROM dwh.PharmacySegmentation\r\n\r\nUNION ALL\r\nSELECT \r\n    'Notebook Output Check',\r\n    'Distinct pharmacies segmented',\r\n    COUNT(DISTINCT PharmacyID),\r\n    'Should match number of pharmacies used in the model'\r\nFROM dwh.PharmacySegmentation\r\n\r\nUNION ALL\r\nSELECT \r\n    'Notebook Output Check',\r\n    'Missing segment labels',\r\n    COUNT(*),\r\n    'Should be 0'\r\nFROM dwh.PharmacySegmentation\r\nWHERE SegmentLabel IS NULL;",
                "type": "Expression"
              },
              "type": "Query"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
