            {
              "text": {
                "value": "INSERT INTO dwh.FactSales\n(\n    PK_SaleID,\n    FK_Date,\n    FK_Time,\n    FK_Product,\n    FK_Pharmacy,\n    FK_Location,\n    FK_Operator,\n    FK_POS,\n    Qty,\n    Amount,\n    CurrencyCode,\n    SourceSaleDateTime,\n    LoadDateTime\n)\nSELECT\n    s.SaleID AS PK_SaleID,\n    s.FK_Date,\n    s.FK_Time,\n    s.FK_Product,\n    s.FK_Pharmacy,\n    s.FK_Location,\n    s.FK_Operator,\n    s.FK_POS,\n    s.Qty,\n    s.Amount,\n    s.CurrencyCode,\n    s.SourceSaleDateTime,\n    CURRENT_TIMESTAMP AS LoadDateTime\nFROM stg.FactSales_IncrementalBatch s\nWHERE s.SaleID >\n(\n    SELECT COALESCE(LastSaleID, 0)\n    FROM etl.Watermark\n    WHERE ProcessName = 'Load_FactSales'\n)\nAND NOT EXISTS\n(\n    SELECT 1\n    FROM dwh.FactSales f\n    WHERE f.PK_SaleID = s.SaleID\n)\nAND s.SaleID IS NOT NULL\nAND s.FK_Date IS NOT NULL\nAND s.FK_Time IS NOT NULL\nAND s.FK_Product IS NOT NULL\nAND s.FK_Pharmacy IS NOT NULL\nAND s.FK_Location IS NOT NULL\nAND s.FK_Operator IS NOT NULL\nAND s.FK_POS IS NOT NULL;",
                "type": "Expression"
